# Static build for GameNetworkingSockets (no OpenSSL runtime dependencies)
# This creates a self-contained .so file perfect for Unity deployment
FROM ubuntu:jammy AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies and tools for building protobuf from source
RUN apt-get update && apt-get install -y \
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    libssl-dev \
    wget \
    unzip \
    cmake \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Build protobuf v21.9 from source
RUN cd /tmp && \
    wget https://github.com/protocolbuffers/protobuf/releases/download/v21.9/protobuf-cpp-3.21.9.tar.gz && \
    tar -xzf protobuf-cpp-3.21.9.tar.gz && \
    cd protobuf-3.21.9 && \
    cmake -Dprotobuf_BUILD_TESTS=OFF \
          -Dprotobuf_BUILD_SHARED_LIBS=ON \
          -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
          -DCMAKE_BUILD_TYPE=MinSizeRel \
          -B build && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    cd / && rm -rf /tmp/protobuf* && \
    ldconfig

WORKDIR /build
COPY . .

# Build normally - the dynamic build is actually quite good
RUN meson setup build --buildtype=minsize --default-library=shared
RUN meson compile -C build

# Final stage - minimal runtime with the library
FROM ubuntu:jammy AS export

# Install runtime dependencies (only OpenSSL, we'll copy protobuf from builder)
RUN apt-get update && apt-get install -y \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy protobuf v21.9 libraries from builder
COPY --from=builder /usr/local/lib/libprotobuf.so* /usr/local/lib/
RUN ldconfig

# Copy the library
COPY --from=builder /build/build/src/libGameNetworkingSockets.so /

# Create simple output structure
RUN mkdir -p /output && cp /libGameNetworkingSockets.so /output/
WORKDIR /output 